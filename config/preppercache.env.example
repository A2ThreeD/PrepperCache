# Copy to config/preppercache.env and adjust as needed.

PREPPERCACHE_ROOT=/opt/preppercache
PREPPERCACHE_SRC_DIR=/opt/preppercache/src
PREPPERCACHE_WEB_ROOT=/srv/preppercache/www
PREPPERCACHE_DATA_ROOT=/srv/preppercache/data
PREPPERCACHE_ADMIN_ROOT=/srv/preppercache/www/admin
PREPPERCACHE_MAPS_ROOT=/srv/preppercache/www/maps

PREPPERCACHE_INSTALL_KIWIX=1
PREPPERCACHE_INSTALL_KOLIBRI=0
PREPPERCACHE_INSTALL_KA_LITE=0
PREPPERCACHE_INSTALL_MAPS=1
PREPPERCACHE_AP_ENABLED=0
PREPPERCACHE_AP_INTERFACE=wlan0
PREPPERCACHE_AP_ADDRESS=192.168.50.1
PREPPERCACHE_AP_NETMASK=255.255.255.0
PREPPERCACHE_AP_CIDR=24
PREPPERCACHE_AP_DHCP_START=192.168.50.50
PREPPERCACHE_AP_DHCP_END=192.168.50.150
PREPPERCACHE_AP_DHCP_LEASE=12h
PREPPERCACHE_AP_CHANNEL=6
PREPPERCACHE_AP_COUNTRY=US

ADMIN_PORT=8081
KIWIX_PORT=8080
KIWIX_BIND_ADDRESS=auto
KIWIX_LIBRARY_DIR=/library/zims/content
KIWIX_LIBRARY_XML=/srv/preppercache/data/kiwix/library.xml
KIWIX_AUTO_LIBRARY_XML=1
KIWIX_HOST=0.0.0.0

PREPPERCACHE_ZIM_PROFILE=essential
PREPPERCACHE_ZIM_MODE=full
PREPPERCACHE_ZIM_DOWNLOAD_JOBS=3
PREPPERCACHE_WIKIPEDIA_OPTION=top-mini
PREPPERCACHE_MAP_PMTILES_ROOT=/maps
PREPPERCACHE_MAP_PMTILES_FILE=
# Optional local path or HTTPS URL. Leave empty to use a recent Protomaps daily build.
PREPPERCACHE_MAP_BUILD_SOURCE=
PREPPERCACHE_ZIM_CATALOG_URL=https://cdimage.debian.org/mirror/kiwix.org/zim/
PREPPERCACHE_HOST_IP=192.168.50.1
PREPPERCACHE_HOST_FALLBACK_IP=127.0.0.1
PREPPERCACHE_HOST_FALLBACK_NAME=localhost
PREPPERCACHE_HOST_IP_LIST=
PREPPERCACHE_HOSTNAME=preppercache
PREPPERCACHE_AP_SSID=PrepperCache
PREPPERCACHE_AP_PASSPHRASE=PrepperCacheLocal
PREPPERCACHE_HTTP_PORT=80
PREPPERCACHE_CONTENT_TAG_CSV=
PREPPERCACHE_ALLOW_LEGACY_KA_LITE=0
